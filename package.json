{
  "name": "dsh-session-showcase",
  "version": "0.2.0",
  "description": "Turn DeepSeek Harness sessions into redacted, README-ready animated demos — as a local CLI or DSH plugin.",
  "type": "module",
  "bin": {
    "dsh-showcase": "dist/cli.js"
  },
  "main": "./dist/plugin.js",
  "types": "./dist/plugin.d.ts",
  "exports": {
    ".": {
      "types": "./dist/plugin.d.ts",
      "import": "./dist/plugin.js"
    },
    "./core": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "files": [
    "dist",
    "cordis.patch.yml",
    "src",
    "assets",
    "examples",
    "schemas",
    "docs",
    "AGENTS.md",
    "CONTRIBUTING.md",
    "CODE_OF_CONDUCT.md",
    "README.md",
    "llms.txt",
    "CHANGELOG.md",
    "LICENSE",
    "SECURITY.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22.19.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "oxlint src test scripts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --pool=threads --maxWorkers=1",
    "test:watch": "vitest --pool=threads --maxWorkers=1",
    "pack:check": "npm pack --dry-run --cache .npm-cache --offline=false",
    "check": "npm run format:check && npm run typecheck && npm run lint && npm test && npm run build && npm run pack:check",
    "demo": "node dist/cli.js examples/session.jsonl --output assets/generated --format both --overwrite",
    "pack:smoke": "node scripts/pack-smoke.mjs",
    "prepare": "npm run build",
    "prepublishOnly": "npm run check"
  },
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "dsh-plugin-demo",
    "ai-agent",
    "agent-session",
    "session-replay",
    "demo-generator",
    "agent-demo",
    "session-to-video",
    "animated-webp",
    "animated-gif",
    "github-readme",
    "redaction",
    "offline",
    "zero-token"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/STFQ/dsh-showcase.git"
  },
  "bugs": {
    "url": "https://github.com/STFQ/dsh-showcase/issues"
  },
  "homepage": "https://github.com/STFQ/dsh-showcase#readme",
  "author": "STFQ",
  "license": "MIT",
  "dependencies": {
    "fflate": "^0.8.2",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-fs": "^0.1.1-rc.1",
    "@deepseek-ai/dsh-tools": "^0.1.1-rc.1",
    "@types/node": "^24.0.0",
    "oxlint": "^1.79.0",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.1",
    "@deepseek-ai/dsh-fs": ">=0.1.1-rc.1",
    "@deepseek-ai/dsh-tools": ">=0.1.1-rc.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-fs": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    }
  }
}
